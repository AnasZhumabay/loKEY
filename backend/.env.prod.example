# Production template for docker-compose.prod.yml. Copy to .env ON THE SERVER and replace every [PLACEHOLDER].
# Never commit .env. Generate secrets: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
LOKEY_DOMAIN=[api.example.com]

POSTGRES_USER=lokey
POSTGRES_DB=lokey
POSTGRES_PASSWORD=[PASSWORD]

LOKEY_SECRET_KEY=[SECRET_KEY_32+_CHARS]
