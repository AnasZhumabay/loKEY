# Template only — real values live in .env (git-ignored).
# Easiest: `sh scripts/init-env.sh` generates .env with random secrets.
# Manual: cp .env.example .env and replace every [PLACEHOLDER].
# Generate a secret: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
LOKEY_ENV=dev

POSTGRES_USER=lokey
POSTGRES_DB=lokey
POSTGRES_PASSWORD=[PASSWORD]

LOKEY_SECRET_KEY=[SECRET_KEY_32+_CHARS]

# Used when running the API / alembic / pytest outside Docker:
LOKEY_DATABASE_URL=postgresql+asyncpg://lokey:[PASSWORD]@localhost:5432/lokey
LOKEY_TEST_DATABASE_URL=postgresql+asyncpg://lokey:[PASSWORD]@localhost:5432/lokey_test
LOKEY_BLOB_DIR=./data/blobs
