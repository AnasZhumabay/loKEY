# Copy to .env for running outside Docker. Never commit .env.
LOKEY_ENV=dev
LOKEY_DATABASE_URL=postgresql+asyncpg://lokey:lokey@localhost:5432/lokey
# Generate for prod: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
LOKEY_SECRET_KEY=dev-only-insecure-secret-change-me
LOKEY_BLOB_DIR=./data/blobs
